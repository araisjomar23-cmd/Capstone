{
  "name": "capstone-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:feedback": "node --experimental-strip-types --test tests/feedbackAnalyzer.test.ts",
    "eval:feedback": "node --experimental-strip-types scripts/eval-feedback.ts",
    "eval:nlp": "node --experimental-strip-types scripts/eval-bisaya-feedback.ts",
    "test:nlp": "node --experimental-strip-types --test tests/feedbackAnalyzer.test.ts tests/feedbackInsights.test.ts tests/bisayaFeedback.test.ts tests/feedbackEvaluation.test.ts",
    "preview": "vite preview",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --linked",
    "db:push": "supabase db push --linked",
    "db:baseline": "supabase migration repair 20261016000000 20261017 --status applied --linked",
    "test:filters": "node --test tests/filterAccuracy.test.cjs",
    "test:dashboard": "node --test tests/dashboardLive.test.cjs tests/filterAccuracy.test.cjs",
    "test:participants": "node --test tests/participantTracking.test.cjs tests/participantProfileOptions.test.cjs tests/filterAccuracy.test.cjs",
    "test:budget": "node --test tests/budgetMonitoring.test.cjs tests/approvedBudget.test.cjs tests/filterAccuracy.test.cjs tests/ppaWorkflow.test.cjs",
    "test:notifications": "node --test tests/notifications.test.cjs",
    "test:ppa": "node --test tests/ppaWorkflow.test.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.58.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.121.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
